# Copy to .env or run `python scripts/ensure_env.py` to generate fresh cryptographic keys.

# Application
APP_NAME="Privacy-Preserving Threat Detection Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL in Docker Compose; SQLite supported for local tests)
DATABASE_URL=postgresql+psycopg://threat_user:threat_pass@postgres:5432/threat_db

# Redis Streams & Pub/Sub
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_KEY=events:raw
REDIS_CONSUMER_GROUP=threat-detectors
REDIS_ALERT_CHANNEL=alerts:broadcast
REDIS_METRICS_CHANNEL=metrics:broadcast

# Security & Cryptography (REPLACE WITH RANDOM 32+ BYTE SECRETS BEFORE RUNNING)
JWT_SECRET_KEY=__GENERATE_HEX_64__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Base64-encoded 32-byte AES-256-GCM master key for PII Vault & HMAC key wrapping
VAULT_MASTER_KEY_B64=__GENERATE_B64_32__
# Initial 32-byte hex key for HMAC-SHA256 pseudonymization (rotated dynamically)
INITIAL_HMAC_KEY_HEX=__GENERATE_HEX_64__

# Privacy & Retention Defaults
DEFAULT_DP_EPSILON=1.0
DEFAULT_RETENTION_DAYS=30
HMAC_ROTATION_HOURS=24
REIDENTIFY_GRANT_TTL_MINUTES=15

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=180
LOGIN_RATE_LIMIT_PER_MINUTE=20

# Streaming / Generator
GENERATOR_INTERVAL_SECONDS=1.5
GENERATOR_ENABLED=true

# Seed demo accounts on startup (disable in hardened production)
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=__GENERATE_DEMO_PW__
